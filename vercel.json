{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "framework": null,
  "redirects": [
    { "source": "/guides/method.html", "destination": "/guides/principles.html", "permanent": true },
    { "source": "/hub/guides/method.html", "destination": "/guides/principles.html?from=hub", "permanent": true },
    { "source": "/hub/guides/principles.html", "destination": "/guides/principles.html?from=hub", "permanent": true },
    { "source": "/hub/guides/tax.html", "destination": "/guides/tax.html?from=hub", "permanent": true },
    { "source": "/hub/guides/taxscenario.html", "destination": "/guides/tax-scenario.html", "permanent": true },
    { "source": "/hub/articles/:slug.html", "destination": "/articles/:slug.html?from=hub", "permanent": true },
    { "source": "/how-we-work", "destination": "/about.html#how-we-work", "permanent": true },
    { "source": "/how-we-work/", "destination": "/about.html#how-we-work", "permanent": true },
    { "source": "/how-we-work/index.html", "destination": "/about.html#how-we-work", "permanent": true },
    { "source": "/book", "destination": "https://wa.me/447843868245?text=Hi%2C%20I%20came%20across%20The%20Everyday%20Investor%20and%20I%27d%20love%20to%20find%20out%20more%20about%20how%20coaching%20could%20help%20me.%20Could%20we%20book%20in%20a%20quick%20call%3F", "permanent": false },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "theeverydayinvestor.uk" }],
      "destination": "https://www.theeverydayinvestor.uk/:path*",
      "permanent": true
    }
  ]
}
