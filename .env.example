# Local admin scripts only — never commit .env or deploy the service role key to Vercel.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SITE_URL=https://your-site.vercel.app

# Vercel build / middleware (set these in Vercel dashboard, not necessarily in .env):
# SUPABASE_ANON_KEY=your-anon-key

# api/feedback-notify.js -- emails an alert on new Wealth OS feedback
# submissions (set these in Vercel dashboard; triggered by a Supabase
# Database Webhook on insert into wealth_os.feedback, see that file's
# header comment):
# RESEND_API_KEY=your-resend-api-key
# FEEDBACK_ALERT_TO=paddyiveson@gmail.com
# FEEDBACK_ALERT_FROM=Wealth OS <alerts@yourdomain>
# FEEDBACK_WEBHOOK_SECRET=choose-a-random-secret-and-put-it-in-the-webhook-header-too

# api/prices.js -- live holding prices for Wealth OS ("Refresh live prices"
# button, Adviser Workspace > Holdings). Set in Vercel dashboard:
# TWELVE_DATA_API_KEY=your-twelve-data-api-key
